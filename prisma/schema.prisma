// Domain model per aequitas-implementation-handoff.md Section 5.
// Prisma enum identifiers can't contain dots; EventType values map the
// dotted prose form (e.g. "case.created", used in Section 8 and the UI
// timeline) to SCREAMING_SNAKE identifiers (CASE_CREATED). Application code
// is the single place that translates between the two.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DisputeCategory {
  RETAIL
  TENANCY
  EMPLOYMENT
  B2B
  FREELANCE
  P2P_MARKETPLACE
  PARTNERSHIP
}

enum GlobalRole {
  COMPLAINANT
  RESPONDENT
  CASE_MANAGER
  ADMIN
}

enum CaseState {
  DRAFT
  OPEN
  EVIDENCE_INTAKE
  POSITIONS
  DRAFTING
  ISSUED
  RESOLVED_CONSENT
  RESOLVED_DECLINED
  WITHDRAWN
  CLOSED
}

enum ConsentState {
  NOT_GIVEN
  GIVEN
  DECLINED
  REVOKED
}

enum EvidenceKind {
  DOCUMENT
  PHOTO
  MESSAGE
  RECEIPT
  OTHER
}

enum ScanStatus {
  PENDING
  CLEAN
  REJECTED
}

enum RecommendationStatus {
  DRAFT
  ISSUED
  SUPERSEDED
}

enum EventType {
  CASE_CREATED
  CASE_DETAILS_UPDATED
  CASE_SUBMITTED
  CASE_ASSIGNED
  COI_DECLARED
  EVIDENCE_INTAKE_OPENED
  EVIDENCE_SUBMITTED
  EVIDENCE_ACCESSED
  EVIDENCE_SUPERSEDED
  EVIDENCE_INTAKE_CLOSED
  POSITION_SUBMITTED
  CHRONOLOGY_ENTRY_SUBMITTED
  RECOMMENDATION_DRAFT_REQUESTED
  RECOMMENDATION_DRAFT_FAILED
  RECOMMENDATION_DRAFTED
  RECOMMENDATION_ISSUED
  RECOMMENDATION_SUPERSEDED
  CONSENT_GIVEN
  CONSENT_DECLINED
  CONSENT_REVOKED
  CASE_RESOLVED
  CASE_RESOLVED_DECLINED
  CASE_REOPENED
  CASE_WITHDRAWN
  CASE_CLOSED
  EXPORT_GENERATED
  DEADLINE_EXPIRED
  PARTY_NOTIFIED
  NOTE_ADDED
  ACCESS_STAFF_GRANTED
  SOURCE_RECORDED
  CLAIM_RECORDED
  CLAIM_UPDATED
  CLAIM_EVIDENCE_LINKED
  CLAIM_RELATIONSHIP_RECORDED
  REVIEW_RECORDED
  ASSUMPTION_RECORDED
  ASSUMPTION_ACKNOWLEDGED
  ASSUMPTION_CHALLENGED
  ASSUMPTION_REVISED
  ASSUMPTION_ADDED_MID_CASE
  PIPELINE_RETURNED
  PROPOSAL_RECORDED
  PROPOSAL_ACCEPTED
  PROPOSAL_REJECTED
  CONTEXT_FACTOR_RECORDED
  SYNTHESIS_RECORDED
  SYNTHESIS_REJECTED
  CONTESTATION_OPENED
  CONTESTATION_RESPONDED
  CONTESTATION_OVERRULED
  CONTESTATION_WITHDRAWN
  RESOLUTION_APPROVED
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  displayName String
  locale      String   @default("fr-CA")
  globalRole  GlobalRole
  // Phase 3: approver capability (P3-D2). Granted by scripts/grant-approver.ts.
  isApprover  Boolean  @default(false)
  createdAt   DateTime @default(now())

  credentials WebAuthnCredential[]
  invitations Invitation[]

  casesAsComplainant    Case[] @relation("CaseComplainant")
  casesAsRespondent     Case[] @relation("CaseRespondent")
  casesAsCaseManager    Case[] @relation("CaseManager")

  evidenceSubmitted     EvidenceItem[]
  positionsSubmitted    PositionStatement[]
  chronologySubmitted   ChronologyEntry[]
  recommendationsIssued Recommendation[]
  consentRecords        ConsentRecord[]
  coiDeclarations       CoiDeclaration[]
  exportsGenerated      ExportBundle[]
  notifications         Notification[]
  sourcesCreated            Source[]            @relation("SourceCreatedBy")
  claimsCreated             Claim[]             @relation("ClaimCreatedBy")
  claimLinksCreated         ClaimEvidenceLink[] @relation("ClaimLinkCreatedBy")
  claimRelationshipsCreated ClaimRelationship[] @relation("ClaimRelationshipCreatedBy")
  reviewsAuthored           ReviewTrail[]       @relation("ReviewTrailReviewer")
  reviewsCreated            ReviewTrail[]       @relation("ReviewTrailCreatedBy")
  assumptionsCreated        Assumption[]        @relation("AssumptionCreatedBy")
  assumptionsAcknowledged   Assumption[]        @relation("AssumptionAcknowledgedBy")
  proposalsReviewed         PipelineProposal[]  @relation("ProposalReviewedBy")
  contextFactorsCreated     ContextFactor[]     @relation("ContextFactorCreatedBy")
  synthesesCreated          SynthesisVersion[]  @relation("SynthesisCreatedBy")
  contestationsOpened       Contestation[]      @relation("ContestationOpenedBy")
  contestationsResponded    Contestation[]      @relation("ContestationRespondedBy")
  contestationsOverruled    Contestation[]      @relation("ContestationOverruledBy")
}

model WebAuthnCredential {
  id           String   @id @default(uuid())
  userId       String
  credentialId String   @unique
  publicKey    Bytes
  counter      BigInt
  transports   String[]
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])
}

model Invitation {
  id          String   @id @default(uuid())
  userId      String
  tokenHash   String   @unique
  issuedById  String?
  locale      String
  expiresAt   DateTime
  revokedAt   DateTime?
  claimedAt   DateTime?
  emailedAt   DateTime?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Case {
  id                      String    @id @default(uuid())
  referenceNumber         String    @unique
  state                   CaseState
  category                DisputeCategory @default(RETAIL)
  // Nullable so rows created before intake captured a description stay valid.
  // New cases must set disputeDescription; amountAtStakeCents is optional CAD cents.
  disputeDescription      String?
  amountAtStakeCents      Int?
  metadata                Json?
  simulated               Boolean   @default(false)
  // Phase 3 (P3-D1): true on every case that existed before the phase 3
  // migration; those keep the consent-only resolution path. New cases need
  // approver sign-off before consent can resolve them.
  consentOnlyResolution   Boolean   @default(false)
  complainantId           String
  respondentId            String
  caseManagerId           String?
  currentRecommendationId String?
  draftRequestId          String?
  draftRequestedAt        DateTime?
  createdAt               DateTime  @default(now())
  closedAt                DateTime?

  complainant    User @relation("CaseComplainant", fields: [complainantId], references: [id])
  respondent     User @relation("CaseRespondent", fields: [respondentId], references: [id])
  caseManager    User? @relation("CaseManager", fields: [caseManagerId], references: [id])

  evidenceItems       EvidenceItem[]
  positionStatements  PositionStatement[]
  chronologyEntries   ChronologyEntry[]
  recommendations     Recommendation[]
  consentRecords      ConsentRecord[]
  coiDeclarations     CoiDeclaration[]
  events              Event[]
  exportBundles       ExportBundle[]
  notifications       Notification[]
  sources             Source[]
  claims              Claim[]
  claimRelationships  ClaimRelationship[]
  reviews             ReviewTrail[]
  assumptions         Assumption[]
  pipeline            CasePipeline?
  proposals           PipelineProposal[]
  contextFactors      ContextFactor[]
  syntheses           SynthesisVersion[]
  contestations       Contestation[]
}

model EvidenceItem {
  id            String     @id @default(uuid())
  caseId        String
  submittedById String
  kind          EvidenceKind
  title         String
  description   String?
  storageKey    String     @unique
  sha256        String
  byteSize      Int
  mimeType      String
  scanStatus    ScanStatus @default(PENDING)
  simulated     Boolean
  version       Int        @default(1)
  supersedesId  String?
  createdAt     DateTime   @default(now())

  case        Case @relation(fields: [caseId], references: [id])
  submittedBy User @relation(fields: [submittedById], references: [id])
  citedBySources Source[]
}

model PositionStatement {
  id        String   @id @default(uuid())
  caseId    String
  partyId   String
  body      String
  locale    String
  version   Int      @default(1)
  createdAt DateTime @default(now())

  case  Case @relation(fields: [caseId], references: [id])
  party User @relation(fields: [partyId], references: [id])
}

// Party-reported events, not the application's submission/activity timestamps.
model ChronologyEntry {
  id            String   @id @default(uuid())
  caseId        String
  submittedById String
  occurredOn    DateTime @db.Date
  title         String
  description   String
  locale        String
  createdAt     DateTime @default(now())

  case        Case @relation(fields: [caseId], references: [id])
  submittedBy User @relation(fields: [submittedById], references: [id])

  @@index([caseId, occurredOn, createdAt])
}

model Recommendation {
  id            String               @id @default(uuid())
  caseId        String
  version       Int                  @default(1)
  status        RecommendationStatus
  explanation   Json
  modelId       String
  promptVersion String
  issuedById    String?
  issuedAt      DateTime?
  createdAt     DateTime             @default(now())

  case     Case  @relation(fields: [caseId], references: [id])
  issuedBy User? @relation(fields: [issuedById], references: [id])

  consentRecords ConsentRecord[]
  reviews        ReviewTrail[]

  @@unique([caseId, version])
}

model ConsentRecord {
  id                 String        @id @default(uuid())
  caseId             String
  recommendationId   String
  partyId            String
  state              ConsentState
  statementVersionId String
  locale             String
  authContext        Json
  givenAt            DateTime?
  declinedAt         DateTime?
  revokedAt          DateTime?
  createdAt          DateTime      @default(now())

  case           Case                     @relation(fields: [caseId], references: [id])
  recommendation Recommendation           @relation(fields: [recommendationId], references: [id])
  party          User                     @relation(fields: [partyId], references: [id])
  statementVersion ConsentStatementVersion @relation(fields: [statementVersionId], references: [id])
}

model ConsentStatementVersion {
  id            String   @id @default(uuid())
  version       Int
  locale        String
  body          String
  effectiveFrom DateTime

  consentRecords ConsentRecord[]

  @@unique([version, locale])
}

model CoiDeclaration {
  id            String   @id @default(uuid())
  caseId        String
  caseManagerId String
  hasConflict   Boolean
  details       String?
  declaredAt    DateTime @default(now())

  case        Case @relation(fields: [caseId], references: [id])
  caseManager User @relation(fields: [caseManagerId], references: [id])
}

model Event {
  id        String    @id @default(uuid())
  caseId    String
  seq       Int
  type      EventType
  actorId   String
  payload   Json
  prevHash  String
  hash      String    @unique
  createdAt DateTime  @default(now())

  case Case @relation(fields: [caseId], references: [id])

  @@unique([caseId, seq])
}

model ExportBundle {
  id            String   @id @default(uuid())
  caseId        String
  generatedById String
  storageKey    String   @unique
  sha256        String
  generatedAt   DateTime @default(now())

  case        Case @relation(fields: [caseId], references: [id])
  generatedBy User @relation(fields: [generatedById], references: [id])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  caseId    String
  kind      String
  locale    String
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
  case Case @relation(fields: [caseId], references: [id])
}

// Phase 1 traceable core. Additive on the dispute case model above.
// A claim without a verbatim excerpt is stored, but presentation forces
// status NEEDS_EVIDENCE. Impact statements are never treated as factual claims.

enum ClaimType {
  FACTUAL
  CAUSAL
  MORAL
  IDENTITY
  POLICY
  IMPACT_STATEMENT
}

enum ClaimConfidence {
  ESTABLISHED
  PROBABLE
  DISPUTED
  UNKNOWN
}

enum ClaimStatus {
  OPEN
  NEEDS_EVIDENCE
  DISPUTED
  MERGED
  SUPERSEDED
  WITHDRAWN
}

enum SourceKind {
  DOCUMENT
  MESSAGE
  TESTIMONY
  POLICY
  RECORD
  URL
  EVIDENCE_ITEM
  STATUTE
}

enum SourceVisibility {
  CASE
  RESTRICTED
  REDACTED
}

enum ClaimLinkPredicate {
  ORIGINATES_FROM
  SUPPORTS
  CONTRADICTS
  QUALIFIES
}

enum ClaimRelationPredicate {
  SUPPORTS
  CONTRADICTS
  QUALIFIES
  INTERPRETS
  EXPERIENCED_BY
  OCCURRED_BEFORE
  ALLEGED_TO_HAVE_CONTRIBUTED_TO
  CONSISTENT_WITH
  AMPLIFIED_BY
  GOVERNED_BY
  REQUIRES_REVIEW
  UNRESOLVED_WITH
  PROPOSES_REPAIR_FOR
  CONTESTED_BY
}

enum ReviewAction {
  NOTED
  EDITED
  APPROVED
  REJECTED
  OVERRULED_CONTESTATION
}

model Source {
  id             String           @id @default(uuid())
  caseId         String
  kind           SourceKind
  title          String
  origin         String?
  obtainedVia    String?
  language       String           @default("fr-CA")
  sensitive      Boolean          @default(false)
  visibility     SourceVisibility @default(CASE)
  contentRef     String?
  citation       String?
  legalFramework String?
  // Optional full text. A pipeline excerpt is kept only when it is a verbatim substring of this body.
  body           String?
  evidenceItemId String?
  publishedAt    DateTime?
  createdAt      DateTime         @default(now())
  createdById    String
  deletedAt      DateTime?
  deletionReason String?

  case          Case                @relation(fields: [caseId], references: [id])
  createdBy     User                @relation("SourceCreatedBy", fields: [createdById], references: [id])
  evidenceItem  EvidenceItem?       @relation(fields: [evidenceItemId], references: [id])
  evidenceLinks ClaimEvidenceLink[]
  relationships ClaimRelationship[]

  @@index([caseId, createdAt])
}

model Claim {
  id                      String          @id @default(uuid())
  caseId                  String
  claimType               ClaimType
  text                    String
  confidence              ClaimConfidence @default(UNKNOWN)
  confidenceRationale     String?
  status                  ClaimStatus     @default(NEEDS_EVIDENCE)
  mergedIntoId            String?
  locale                  String          @default("fr-CA")
  doNotSummarizeAsSettled Boolean         @default(false)
  createdAt               DateTime        @default(now())
  createdById             String
  deletedAt               DateTime?
  deletionReason          String?

  case              Case                @relation(fields: [caseId], references: [id])
  createdBy         User                @relation("ClaimCreatedBy", fields: [createdById], references: [id])
  mergedInto        Claim?              @relation("ClaimMerge", fields: [mergedIntoId], references: [id])
  mergedFrom        Claim[]             @relation("ClaimMerge")
  evidenceLinks     ClaimEvidenceLink[]
  relationshipsFrom ClaimRelationship[] @relation("RelationshipFrom")
  relationshipsTo   ClaimRelationship[] @relation("RelationshipTo")
  reviews           ReviewTrail[]

  @@index([caseId, createdAt])
}

model ClaimEvidenceLink {
  id             String             @id @default(uuid())
  claimId        String
  sourceId       String
  predicate      ClaimLinkPredicate
  excerpt        String
  rationale      String?
  createdAt      DateTime           @default(now())
  createdById    String
  deletedAt      DateTime?
  deletionReason String?

  claim     Claim  @relation(fields: [claimId], references: [id])
  source    Source @relation(fields: [sourceId], references: [id])
  createdBy User   @relation("ClaimLinkCreatedBy", fields: [createdById], references: [id])

  @@index([claimId])
  @@index([sourceId])
}

model ClaimRelationship {
  id             String                 @id @default(uuid())
  caseId         String
  fromClaimId    String
  toClaimId      String
  predicate      ClaimRelationPredicate
  evidenceId     String?
  rationale      String?
  createdAt      DateTime               @default(now())
  createdById    String
  deletedAt      DateTime?
  deletionReason String?

  case      Case    @relation(fields: [caseId], references: [id])
  fromClaim Claim   @relation("RelationshipFrom", fields: [fromClaimId], references: [id])
  toClaim   Claim   @relation("RelationshipTo", fields: [toClaimId], references: [id])
  evidence  Source? @relation(fields: [evidenceId], references: [id])
  createdBy User    @relation("ClaimRelationshipCreatedBy", fields: [createdById], references: [id])

  @@index([caseId, createdAt])
}

model ReviewTrail {
  id          String       @id @default(uuid())
  caseId      String
  claimId     String?
  // Nullable. Phase 3 approves a synthesis; Phase 2 only records one after validation.
  synthesisId String?
  // Phase 3: approver sign-off binds to one recommendation version.
  recommendationId String?
  reviewerId  String
  action      ReviewAction
  rationale   String?
  snapshot    Json?
  createdAt   DateTime     @default(now())
  createdById String

  case      Case   @relation(fields: [caseId], references: [id])
  claim     Claim? @relation(fields: [claimId], references: [id])
  reviewer   User               @relation("ReviewTrailReviewer", fields: [reviewerId], references: [id])
  createdBy  User               @relation("ReviewTrailCreatedBy", fields: [createdById], references: [id])
  synthesis  SynthesisVersion?  @relation(fields: [synthesisId], references: [id])
  recommendation Recommendation? @relation(fields: [recommendationId], references: [id])

  @@index([caseId, createdAt])
  @@index([recommendationId])
}

enum AssumptionOrigin {
  CASE_FRAMING
  PARTY_STATEMENT
  ANALYST_NOTE
  MID_CASE
}

enum AssumptionStatus {
  PROPOSED
  ACKNOWLEDGED
  CHALLENGED
  REVISED
}

enum PipelineStageName {
  EPOCHE
  CLAIM_DECOMPOSITION
  CONTEXT_MAPPING
  SYNTHESIS
}

enum ProposalKind {
  CLAIM
  CONTEXT_FACTOR
}

enum ProposalStatus {
  PROPOSED
  ACCEPTED
  REJECTED
}

enum ContextFactorType {
  POLICY_VS_PRACTICE
  INTERFACES_VS_DEPENDENCIES
  AUTHORITY_VS_IMPLEMENTATION
}

enum GapDiagnosis {
  ADAPTIVE
  PROTECTIVE
  EVASIVE
  FRAUDULENT
  NO_GAP_FOUND
}

model Assumption {
  id               String            @id @default(uuid())
  caseId           String
  text             String
  origin           AssumptionOrigin
  status           AssumptionStatus  @default(PROPOSED)
  createdById      String
  acknowledgedById String?
  acknowledgedAt   DateTime?
  createdAt        DateTime          @default(now())
  deletedAt        DateTime?

  case           Case  @relation(fields: [caseId], references: [id])
  createdBy      User  @relation("AssumptionCreatedBy", fields: [createdById], references: [id])
  acknowledgedBy User? @relation("AssumptionAcknowledgedBy", fields: [acknowledgedById], references: [id])

  @@index([caseId, createdAt])
}

model CasePipeline {
  caseId    String            @id
  stage     PipelineStageName @default(EPOCHE)
  updatedAt DateTime          @updatedAt

  case Case @relation(fields: [caseId], references: [id])
}

model PipelineProposal {
  id                String         @id @default(uuid())
  caseId            String
  kind              ProposalKind
  status            ProposalStatus @default(PROPOSED)
  payload           Json
  modelId           String
  promptVersion     String
  createdAt         DateTime       @default(now())
  reviewedById      String?
  reviewedAt        DateTime?
  acceptedClaimId   String?

  case          Case           @relation(fields: [caseId], references: [id])
  reviewedBy    User?          @relation("ProposalReviewedBy", fields: [reviewedById], references: [id])
  contextFactor ContextFactor?

  @@index([caseId, createdAt])
}

model ContextFactor {
  id          String            @id @default(uuid())
  caseId      String
  factorType  ContextFactorType
  description String
  gapMap      Json
  diagnosis   GapDiagnosis
  evidenceId  String?
  proposalId  String?           @unique
  createdById String
  createdAt   DateTime          @default(now())
  deletedAt   DateTime?

  case      Case              @relation(fields: [caseId], references: [id])
  createdBy User              @relation("ContextFactorCreatedBy", fields: [createdById], references: [id])
  proposal  PipelineProposal? @relation(fields: [proposalId], references: [id])

  @@index([caseId, createdAt])
}

model SynthesisVersion {
  id           String   @id @default(uuid())
  caseId       String
  version      Int
  sections     Json
  sentenceMap  Json
  diagE        String
  diagP        String
  diagC        String
  modelId      String?
  createdById  String
  createdAt    DateTime @default(now())

  case      Case          @relation(fields: [caseId], references: [id])
  createdBy User          @relation("SynthesisCreatedBy", fields: [createdById], references: [id])
  reviews   ReviewTrail[]

  @@unique([caseId, version])
  @@index([caseId, createdAt])
}

// --- Phase 3: contestation -------------------------------------------------

enum ContestationStatus {
  OPEN
  RESPONDED
  OVERRULED
  WITHDRAWN
}

enum ContestationTarget {
  CLAIM
  SYNTHESIS
  PROPOSAL
  RECOMMENDATION
}

model Contestation {
  id             String             @id @default(uuid())
  caseId         String
  targetType     ContestationTarget
  targetId       String
  grounds        String
  status         ContestationStatus @default(OPEN)
  openedById     String
  response       String?
  respondedById  String?
  respondedAt    DateTime?
  overruleReason String?
  overruledById  String?
  overruledAt    DateTime?
  withdrawnAt    DateTime?
  createdAt      DateTime           @default(now())

  case        Case  @relation(fields: [caseId], references: [id])
  openedBy    User  @relation("ContestationOpenedBy", fields: [openedById], references: [id])
  respondedBy User? @relation("ContestationRespondedBy", fields: [respondedById], references: [id])
  overruledBy User? @relation("ContestationOverruledBy", fields: [overruledById], references: [id])

  @@index([caseId, status])
}
