    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "archiver": "^8.0.0",
    "dotenv": "^17.4.2",
    "file-type": "^22.0.1",
    "next": "^16.3.5",
    "next-intl": "^4.13.6",
    "pdf-lib": "^1.17.1",
